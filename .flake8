[flake8]
# Line length configuration
max-line-length = 100

# Exclude specific directories from flake8 checks
exclude =
    .git,
    .tox,
    .venv,
    __pycache__,
    *.egg,
    build,
    dist

# Ignore specific errors globally
ignore =
    # Line break before binary operator - used extensively throughout codebase
    W503,
    # Whitespace before ':' - used for alignment in many places
    E203,
    # Multiple spaces - used for alignment in many places
    E241, E226,
    # Lambda assignments - used extensively, would require significant refactoring
    E731,
    # Type comparisons - safer to fix on a case-by-case basis
    E721,
    # Trailing whitespace
    W291

# Focus on certain error types
select = E,W,F

# Per-file-ignores for specific files with too many issues to fix at once
per-file-ignores =
    # Files with line length issues
    pyasn1/codec/*/*.py:E501
    pyasn1/type/base.py:E501
    pyasn1/type/univ.py:E501,E741,F821,F841
    # Files with other specific issues that would need careful refactoring
    pyasn1/__init__.py:F401
    pyasn1/compat/octets.py:E731
    pyasn1/type/constraint.py:F811
    pyasn1/type/namedtype.py:E731
    # Test files with specific issues
    tests/compat/test_octets.py:E712,F811
    tests/compat/test_binary.py:E722
    tests/codec/der/test_encoder.py:F821
    tests/codec/ber/test_encoder.py:F841
    tests/type/test_univ.py:E712,E721,F811

# Output format
format = %(path)s:%(row)d:%(col)d: %(code)s %(text)s
