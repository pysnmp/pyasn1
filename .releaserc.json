{
  "branches": [
    "+([0-9])?(.{+([0-9]),x}).x",
    "main",
    {
      "name": "next",
      "prerelease": "rc"
    }
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    [
      "@google/semantic-release-replace-plugin",
      {
        "replacements": [
          {
            "countMatches": true,
            "files": [
              "pyasn1/__init__.py"
            ],
            "from": "__version__ ?=.*",
            "results": [
              {
                "file": "pyasn1/__init__.py",
                "hasChanged": true,
                "numMatches": 1,
                "numReplacements": 1
              }
            ],
            "to": "__version__ = \"${nextRelease.version}\""
          },
          {
            "countMatches": true,
            "files": [
              "pyproject.toml"
            ],
            "from": "^version ?=.*",
            "results": [
              {
                "file": "pyproject.toml",
                "hasChanged": true,
                "numMatches": 1,
                "numReplacements": 1
              }
            ],
            "to": "version = \"${nextRelease.version}\""
          }
        ]
      }
    ],
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md",
        "changelogTitle": "# Changelog\n\nGenerated from the commit history at release time. The narrative history\nthrough 1.3.0 is in [CHANGES.rst](https://github.com/pysnmp/pyasn1/blob/main/CHANGES.rst)."
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "./.github/workflows/sr-prepare.sh ${nextRelease.version}",
        "shell": "bash"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "NOTICE",
          "pyproject.toml",
          "pyasn1/__init__.py",
          "uv.lock"
        ],
        "message": "chore(release): ${nextRelease.version}\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          "NOTICE",
          "pyproject.toml"
        ]
      }
    ]
  ]
}
