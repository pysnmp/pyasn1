{
  "branches": [
    "+([0-9])?(.{+([0-9]),x}).x",
    "main",
    {
      "channel": "beta",
      "name": "develop",
      "prerelease": "beta"
    }
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    [
      "@google/semantic-release-replace-plugin",
      {
        "replacements": [
          {
            "countMatches": true,
            "files": [
              "pyasn1/__init__.py"
            ],
            "from": "__version__ ?=.*",
            "results": [
              {
                "file": "pyasn1/__init__.py",
                "hasChanged": true,
                "numMatches": 1,
                "numReplacements": 1
              }
            ],
            "to": "__version__ = \"${nextRelease.version}\""
          },
          {
            "countMatches": true,
            "files": [
              "pyproject.toml"
            ],
            "from": "^version ?=.*",
            "results": [
              {
                "file": "pyproject.toml",
                "hasChanged": true,
                "numMatches": 1,
                "numReplacements": 1
              }
            ],
            "to": "version = \"${nextRelease.version}\""
          }
        ]
      }
    ],
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "./.github/workflows/sr-prepare.sh ${nextRelease.version}",
        "publishCmd": "./.github/workflows/sr-release.sh",
        "shell": "bash"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "NOTICE",
          "pyproject.toml",
          "pyasn1/__init__.py"
        ],
        "message": "chore(release): ${nextRelease.version}\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          "NOTICE",
          "pyproject.toml"
        ]
      }
    ]
  ]
}
